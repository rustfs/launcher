{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustFS Launcher",
  "version": "0.1.0",
  "identifier": "com.dandan.rustfs-launcher",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustFS Launcher",
        "width": 800,
        "height": 800,
        "minWidth": 800,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODI0RTNDNzJEQzAyMjYKUldRbUF0eHlQRTZDUDl0V2FqNkk1Wm5SakpIMkRwWFJ6RW9RdWZmem1Zbmx4QjBkL28rcWoxYUcK",
      "endpoints": [
        "https://github.com/rustfs/launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
