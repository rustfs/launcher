{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustFS Launcher",
  "version": "0.1.0",
  "identifier": "com.dandan.rustfs-launcher",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustFS Launcher",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCOEZBMjlBRUZGMzNENjkKUldScFBmUHZtcUtQdTdPVDJFYitWQlR1NW1tWlJqV3RZNHErb21sMC9tVXVJRkJqMUtMaUpsY2cK",
      "endpoints": [
        "https://github.com/rustfs/launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
